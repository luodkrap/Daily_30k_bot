# ─── 실행 모드 ──────────────────────────────────────────────
# live    → 바이낸스 실거래 (BINANCE_API_KEY / BINANCE_SECRET_KEY 사용)
# testnet → https://testnet.binance.vision 가상 자금
#            (BINANCE_TESTNET_API_KEY / BINANCE_TESTNET_SECRET_KEY 사용)
# ⚠ 실거래 키를 testnet 필드에 복붙하거나 반대로 하는 것 절대 금지.
#   부팅 시 텔레그램 메시지의 [MODE=LIVE/TESTNET] 로 재확인할 것.
MODE=live

# ─── 실거래 API 키 (MODE=live 일 때만 사용) ─────────────────
BINANCE_API_KEY=여기에_바이낸스_실거래_API_키_입력
BINANCE_SECRET_KEY=여기에_바이낸스_실거래_시크릿_키_입력

# ─── Testnet API 키 (MODE=testnet 일 때만 사용) ────────────
# 발급: https://testnet.binance.vision (구글/깃허브 로그인 후 HMAC_SHA256 키 생성)
BINANCE_TESTNET_API_KEY=여기에_testnet_API_키_입력
BINANCE_TESTNET_SECRET_KEY=여기에_testnet_시크릿_키_입력

# ─── 텔레그램 ───────────────────────────────────────────────
TELEGRAM_TOKEN=여기에_텔레그램_봇_토큰_입력
TELEGRAM_CHAT_ID=여기에_텔레그램_채팅_ID_입력

# ─── 시드머니 (원화) ────────────────────────────────────────
SEED=3000000
