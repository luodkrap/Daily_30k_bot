[Unit]
Description=Daily 30K Bot — Binance auto-trading
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=ubuntu
WorkingDirectory=/home/ubuntu/Daily_30k_bot
EnvironmentFile=/home/ubuntu/Daily_30k_bot/.env
Environment=PYTHONUNBUFFERED=1
ExecStart=/home/ubuntu/Daily_30k_bot/venv/bin/python main.py
# N29-A: 봇 종료(정상/실패/OOM) 시 텔레그램 즉시 알림. 봇 프로세스가 죽어도
# systemd 가 직접 호출하므로 외부 watchdog 없이 사망 감지 가능. 5/13 KILL_SWITCH
# 후 34시간 침묵 사건 재발 방지. 알림 실패는 서비스 정책에 영향 없음(exit 0).
ExecStopPost=/home/ubuntu/Daily_30k_bot/deploy/notify_death.sh
Restart=on-failure
RestartSec=10
# N12 (2026-05-04): logs/*.log append → journald 전환. 자동 timestamp(microsecond UTC)
# + 자동 rotate(SystemMaxUse 기본 10% disk) + 시간 쿼리(`journalctl --since`) + 에러 필터(`-p err`).
# 이전 시스템은 print 캡처라 timestamp 부재 → 4/28~5/4 6일 hang 사건의 사후 디버깅 거의 불가능했던 게 교훈.
StandardOutput=journal
StandardError=journal
SyslogIdentifier=daily30k

# 메모리 상한 — 1GB RAM Lightsail 에서 OOM 방지
MemoryMax=512M

[Install]
WantedBy=multi-user.target
